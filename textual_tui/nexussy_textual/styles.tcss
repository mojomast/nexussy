Screen {
  background: #0b1020;
  color: #d6e2ff;
}

#header-bar, #status-bar {
  dock: top;
  height: 1;
  background: #14213d;
  color: #f8f9fa;
}

#status-bar {
  dock: bottom;
}

#body {
  height: 1fr;
}

#pipeline-sidebar {
  width: 34;
  border: solid #4cc9f0;
  padding: 0 1;
}

#main-pane {
  width: 1fr;
  border: solid #4361ee;
  padding: 0 1;
}

#inspector-panel {
  width: 42;
  border: solid #7209b7;
  padding: 0 1;
}

#composer-box {
  dock: bottom;
  min-height: 4;
  height: 6;
  max-height: 8;
  border: solid #f72585;
  padding: 0 1;
}

.panel-title, .modal-title {
  text-style: bold;
  color: #ffd166;
}

.button-row {
  height: 3;
}

Button:focus, Input:focus, ListView:focus, DataTable:focus {
  border: heavy #ffd166;
}

Button:disabled {
  opacity: 0.4;
  color: #555555;
  background: #1a1a2e;
}

#composer {
  width: 100%;
  height: 3;
  margin-top: 1;
}

#gate-card {
  border: heavy #ffd166;
  padding: 0 1;
  height: auto;
  max-height: 10;
}

#interview-panel {
  border: solid #06d6a0;
  padding: 0 1;
  height: auto;
  max-height: 8;
}

#stage-controls {
  height: auto;
  max-height: 7;
}

#transcript-panel {
  height: 1fr;
}
